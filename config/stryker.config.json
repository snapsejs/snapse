{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/functionalTests/**",
    "!src/**/internalTests/**",
    "!src/common/test/**",
    "!src/undo/benchmarks/**",
    "!src/snapseAll.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  },
  "tempDirName": ".stryker-tmp"
}
